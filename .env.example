# Base URL of the SMS Notification Microservice.
# The backend is expected on 3001 so it does not collide with the Next.js dev server on 3000.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Must mirror SMS_MAX_MESSAGE_LENGTH on the backend. Used only for the character
# counter and client-side validation; the backend remains the authority.
NEXT_PUBLIC_SMS_MAX_MESSAGE_LENGTH=1600
